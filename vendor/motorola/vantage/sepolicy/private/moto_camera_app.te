# Domain of Motorola Camera (com.motorola.camera5).
# Ported from the stock product/system_ext policy; see
# reports/sepolicy-slice/moto_camera_app.te.txt and motoappdomain.te.txt.
# Camera HAL, DSP and perf HAL access is granted by the stock vendor policy through the
# moto_camera_app_202504 mapping and the moto_qcxdsp_domain attribute.

typeattribute moto_camera_app coredomain;

app_domain(moto_camera_app)
net_domain(moto_camera_app)
bluetooth_domain(moto_camera_app)

typeattribute moto_camera_app motoappdomain;
typeattribute moto_camera_app moto_qcxdsp_domain;

# Rules attached to motoappdomain on stock (system_ext policy).
allow motoappdomain {
    app_api_service
    system_api_service
    audioserver_service
    cameraserver_service
    drmserver_service
    mediadrmserver_service
    mediaextractor_service
    mediametrics_service
    mediaserver_service
    network_watchlist_service
    nfc_service
    radio_service
    thermal_service
    gpu_service
}:service_manager find;

binder_call(motoappdomain, gpuservice)
