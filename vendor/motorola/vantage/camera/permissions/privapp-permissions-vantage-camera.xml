<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged-permission allowlist for Motorola Camera, identical to stock
     /product/etc/permissions/privapp-permissions-com.motorola.camera5.xml. -->
<permissions>
    <privapp-permissions package="com.motorola.camera5">
        <permission name="android.permission.STOP_APP_SWITCHES"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
    </privapp-permissions>
</permissions>
