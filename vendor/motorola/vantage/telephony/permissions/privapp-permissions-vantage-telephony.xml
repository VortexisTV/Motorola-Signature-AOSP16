<?xml version="1.0" encoding="utf-8"?>
<!-- Privileged-permission allowlist for the stock Qualcomm IMS service.
     Mirrors the stock grants found in
       /system/etc/permissions/privapp-permissions-*.xml and
       /system_ext/etc/permissions/telephony_system-ext_privapp-permissions-qti.xml
     (see reports/inventory/permissions.json). Nothing beyond stock is granted. -->
<permissions>
    <privapp-permissions package="org.codeaurora.ims">
        <permission name="android.permission.MODIFY_PHONE_STATE"/>
        <permission name="android.permission.READ_PRECISE_PHONE_STATE"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.INTERACT_ACROSS_USERS"/>
        <permission name="android.permission.SUBSTITUTE_NOTIFICATION_APP_NAME"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.READ_NETWORK_USAGE_HISTORY"/>
    </privapp-permissions>
</permissions>
