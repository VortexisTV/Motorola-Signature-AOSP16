+private const val RETRY_DELAY_MS = 2000L
+private const val STUCK_WARNING_MS = 10000L
+
+// vendor.qti.hardware.radio.am.AudioError (byte-backed in this copy of the interface)
+private const val AUDIO_STATUS_OK: Byte = 0
+private const val AUDIO_GENERIC_FAILURE: Byte = 1
+private const val AUDIO_STATUS_SERVER_DIED: Byte = 2
+
+/**
+ * One AIDL connection to vendor.qti.hardware.radio.am.IQcRilAudio/slotN.
+ *
+ * Each slot is served by its own RIL process and hands out its own response interface, so the
+ * response must be kept per slot. The HAL is waited for instead of looked up once, and the
+ * registration is repeated when the RIL process dies.
+ */
+private class AidlSlot(slot: Int, private val audioManager: AudioManager) : IBinder.DeathRecipient {
+    private val name = "vendor.qti.hardware.radio.am.IQcRilAudio/slot$slot"
+    private val lock = Any()
+    private var hal: IQcRilAudio? = null
+    private var response: IQcRilAudioResponse? = null
+    @Volatile private var audioError = AUDIO_STATUS_OK
+    private val handler = Handler(HandlerThread("QcRilAm-slot$slot").apply { start() }.looper)
+    private val mainHandler = Handler(Looper.getMainLooper())
+
+    private val request = object : IQcRilAudioRequest.Stub() {
+        override fun getInterfaceVersion() = IQcRilAudioRequest.VERSION
+
+        override fun getInterfaceHash() = IQcRilAudioRequest.HASH
+
+        override fun queryParameters(token: Int, params: String) {
+            // AudioManager blocks while audioserver is down; answer instead of stalling the RIL.
+            val value = if (audioManager.isAudioServerRunning) audioManager.getParameters(params) else ""
+            respond { it.queryParametersResponse(token, value) }
+        }
+
+        override fun setParameters(token: Int, params: String) {
+            // AudioManager.setParameters does not return the value coming from
+            // AudioSystem.setParameters. Assume there was no error if audioserver is up.
+            val status = if (audioManager.isAudioServerRunning) {
+                audioManager.setParameters(params)
+                AUDIO_STATUS_OK
+            } else {
+                AUDIO_GENERIC_FAILURE
+            }
+            respond { it.setParametersResponse(token, status) }
+        }
+    }
+
+    private fun respond(block: (IQcRilAudioResponse) -> Unit) {
+        // Taking the lock also waits for a registration that is still in progress.
+        val target = synchronized(lock) { response }
+        if (target == null) {
+            Log.e(TAG, "$name: no response interface, dropping the response")
+            return
+        }
+        try {
+            block(target)
+        } catch (e: Exception) {
+            Log.e(TAG, "$name: sending the response failed", e)
+        }
+    }
+
+    fun start() {
+        handler.post { connect() }
+    }
+
+    /** Runs on the slot's own thread: waitForDeclaredService blocks until the RIL is up. */
+    private fun connect() {
+        try {
+            if (!ServiceManager.isDeclared(name)) {
+                Log.i(TAG, "$name is not declared by the vendor, not using AIDL for it")
+                return
+            }
+            Log.i(TAG, "$name: waiting for the RIL to publish it")
+            val binder = ServiceManager.waitForDeclaredService(name)
+            if (binder == null) {
+                Log.e(TAG, "$name did not appear, trying again")
+                handler.postDelayed({ connect() }, RETRY_DELAY_MS)
+                return
+            }
+            binder.linkToDeath(this, 0)
+            val service = IQcRilAudio.Stub.asInterface(binder)
+            // The steps are logged one by one: on the first test boot this thread never got past
+            // here and there was nothing in the log to say which call it was waiting in.
+            Log.i(TAG, "$name: calling setRequestInterface")
+            val stuck = Runnable {
+                Log.e(TAG, "$name: setRequestInterface has not returned after ${STUCK_WARNING_MS / 1000} s")
+            }
+            mainHandler.postDelayed(stuck, STUCK_WARNING_MS)
+            try {
+                synchronized(lock) {
+                    hal = service
+                    response = service.setRequestInterface(request)
+                }
+            } finally {
+                mainHandler.removeCallbacks(stuck)
+            }
+            Log.i(TAG, "$name: request interface registered")
+            sendAudioError()
+        } catch (e: Exception) {
+            Log.e(TAG, "$name: registration failed, trying again", e)
+            handler.postDelayed({ connect() }, RETRY_DELAY_MS)
+        }
+    }
+
+    override fun binderDied() {
+        Log.w(TAG, "$name died, registering again when it is back")
+        synchronized(lock) {
+            hal = null
+            response = null
+        }
+        handler.post { connect() }
+    }
+
+    /** Tells the RIL whether audioserver is usable, as the vendor's own client does. */
+    fun reportAudioError(error: Byte) {
+        audioError = error
+        handler.post { sendAudioError() }
+    }
+
+    private fun sendAudioError() {
+        val service = synchronized(lock) { hal } ?: return
+        try {
+            service.setError(audioError)
+        } catch (e: Exception) {
+            Log.e(TAG, "$name: setError failed", e)
+        }
+    }
+}
 
